{
  "type": "class",
  "title": "Class diagram: the delivery domain",
  "desc": "Each box is a class: name, attributes, operations. Lines say how classes relate: plain association, whole and part, inheritance, interface, dependency. Numbers at the ends say how many.",
  "classes": [
    {"id": "customer", "label": "Customer", "tone": "blue", "at": [0, 0],
     "attributes": ["+id: UUID", "+name: String", "+email: String"],
     "operations": ["+placeOrder(): Order"]},
    {"id": "order", "label": "Order", "tone": "violet", "at": [0, 1],
     "attributes": ["-id: UUID", "-status: OrderStatus", "-total: Money"],
     "operations": ["+addItem(d: Dish, n: int)", "+cancel()", "+pay(p: Payment)"]},
    {"id": "item", "label": "OrderItem", "tone": "violet", "at": [0, 2],
     "attributes": ["-quantity: int", "-unitPrice: Money"],
     "operations": ["+subtotal(): Money"]},
    {"id": "dish", "label": "Dish", "tone": "green", "at": [0, 3],
     "attributes": ["+name: String", "+price: Money"],
     "operations": ["+isAvailable(): bool"]},
    {"id": "delivery", "label": "Delivery", "tone": "teal", "at": [1, 0],
     "attributes": ["+pickedUpAt: Time", "+deliveredAt: Time"],
     "operations": ["+complete()"]},
    {"id": "payment", "label": "Payment", "kind": "abstract", "tone": "amber", "at": [1, 1],
     "attributes": ["#amount: Money"],
     "operations": ["+authorise(): bool"]},
    {"id": "notifier", "label": "Notifier", "kind": "interface", "at": [1, 2],
     "operations": ["+notify(msg: String)"]},
    {"id": "restaurant", "label": "Restaurant", "tone": "green", "at": [1, 3],
     "attributes": ["+name: String", "+rating: float"],
     "operations": ["+accept(o: Order)"]},
    {"id": "courier", "label": "Courier", "tone": "teal", "at": [2, 0],
     "attributes": ["+name: String", "+vehicle: String"],
     "operations": ["+deliver(o: Order)"]},
    {"id": "card", "label": "CardPayment", "tone": "amber", "at": [2, 0.7],
     "attributes": ["-cardToken: String"],
     "operations": ["+authorise(): bool"]},
    {"id": "wallet", "label": "WalletPayment", "tone": "amber", "at": [2, 1.35],
     "attributes": ["-walletId: String"],
     "operations": ["+authorise(): bool"]},
    {"id": "email", "label": "EmailNotifier", "kind": "class", "tone": "gray", "at": [2, 2],
     "attributes": ["-smtpHost: String"],
     "operations": ["+notify(msg: String)"]}
  ],
  "relations": [
    {"from": "customer", "to": "order", "label": "places", "from_label": "1", "to_label": "0..*"},
    {"from": "order", "to": "item", "style": "composition", "label": "contains", "from_label": "1", "to_label": "1..*"},
    {"from": "item", "to": "dish", "style": "navigable", "label": "of", "from_label": "*", "to_label": "1"},
    {"from": "order", "to": "delivery", "label": "delivered by", "from_label": "1", "to_label": "0..1"},
    {"from": "delivery", "to": "courier", "label": "carries", "from_label": "0..*", "to_label": "1"},
    {"from": "order", "to": "payment", "label": "paid by", "from_label": "1", "to_label": "0..*"},
    {"from": "card", "to": "payment", "style": "inheritance"},
    {"from": "wallet", "to": "payment", "style": "inheritance"},
    {"from": "order", "to": "notifier", "style": "dependency", "label": "uses"},
    {"from": "email", "to": "notifier", "style": "implements"},
    {"from": "restaurant", "to": "dish", "style": "aggregation", "label": "offers", "from_label": "1", "to_label": "0..*"}
  ]
}
