   "tone": "blue",
   "black_box": true
  },
  {
   "id": "refund",
   "tone": "gray"
  },
  {
   "id": "system",
   "label": "System",
   "tone": "violet",
   "parent": "refund"
  },
  {
   "id": "agent",
   "label": "Agent",
   "tone": "blue",
   "parent": "refund"
  },
  {
