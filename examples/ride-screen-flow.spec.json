   "system": "cloud"
  },
  {
   "from": "PaymentMethods",
   "to": "WalletTopUp",
   "trigger": "tap Top up"
  },
  {
   "from": "WalletTopUp",
   "to": "PaymentMethods",
   "trigger": "tap Done",
