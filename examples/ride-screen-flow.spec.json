 "taps": [
  {
   "from": "AppIcon",
   "to": "SplashScreen",
   "trigger": "launch the app",
   "main": true
  },
  {
   "from": "PushTripUpdate",
   "to": "InTrip",
   "trigger": "tap the push notification",
   "code": "C1"
  },
  {
   "from": "DeepLinkPromo",
   "to": "PromoCodeSheet",
   "trigger": "open the promo link"
  },
  {
   "from": "SplashScreen",
   "to": "HasSessionCheck",
   "trigger": "timer ends after 2 s",
   "system": "clock",
   "main": true
  },
  {
   "from": "HasSessionCheck",
   "to": "HomeMap",
   "guard": "session valid",
   "main": true
  },
  {
   "from": "HasSessionCheck",
   "to": "WelcomeCarousel",
   "guard": "no session"
  },
  {
   "from": "WelcomeCarousel",
   "to": "PhoneEntry",
   "trigger": "tap Get started"
  },
  {
   "from": "PhoneEntry",
   "to": "OtpVerification",
   "trigger": "tap Send code"
  },
  {
   "from": "OtpVerification",
   "to": "PhoneEntry",
   "trigger": "tap Wrong number",
   "kind": "back"
  },
  {
   "from": "OtpVerification",
   "to": "ProfileSetup",
   "guard": "code valid"
  },
  {
   "from": "ProfileSetup",
   "to": "LocationPermission",
   "trigger": "tap Continue"
  },
  {
   "from": "LocationPermission",
   "to": "NotificationPermission",
   "trigger": "tap Allow"
  },
  {
   "from": "LocationPermission",
   "to": "HomeMap",
   "route": "elbow",
   "trigger": "tap Not now"
  },
  {
   "from": "NotificationPermission",
   "to": "HomeMap",
   "route": "elbow",
   "trigger": "tap Allow or Skip"
  },
  {
   "from": "HomeMap",
   "to": "DestinationSearch",
   "trigger": "tap Where to",
   "main": true
  },
  {
   "from": "DestinationSearch",
   "to": "SavedPlaces",
   "trigger": "tap Saved"
  },
  {
   "from": "SavedPlaces",
   "to": "DestinationSearch",
   "trigger": "tap Back",
   "kind": "back"
  },
  {
   "from": "DestinationSearch",
   "to": "RideOptions",
   "trigger": "tap a result",
   "main": true
  },
  {
   "from": "SavedPlaces",
   "to": "RideOptions",
   "trigger": "tap a place"
  },
  {
   "from": "RideOptions",
   "to": "FareEstimate",
   "trigger": "tap Choose ride",
   "main": true
  },
  {
   "from": "FareEstimate",
   "to": "PromoCodeSheet",
   "trigger": "tap Add promo"
  },
  {
   "from": "PromoCodeSheet",
   "to": "FareEstimate",
   "trigger": "tap Apply",
   "kind": "back"
  },
  {
   "from": "FareEstimate",
   "to": "ConfirmPickup",
   "trigger": "tap Confirm",
   "main": true
  },
  {
   "from": "ConfirmPickup",
   "to": "FindingDriver",
   "trigger": "tap Request ride",
   "main": true
  },
  {
   "from": "FindingDriver",
   "to": "DriverFoundCheck",
   "trigger": "the API answers",
   "system": "cloud",
   "main": true
  },
  {
   "from": "DriverFoundCheck",
   "to": "DriverAssigned",
   "guard": "driver accepted",
   "main": true
  },
  {
   "from": "DriverFoundCheck",
   "to": "NoDriversFound",
   "guard": "no driver after 60 s",
   "kind": "failure"
  },
  {
   "from": "NoDriversFound",
   "to": "FindingDriver",
   "route": "elbow",
   "trigger": "tap Try again",
   "kind": "retry"
  },
  {
   "from": "NoDriversFound",
   "to": "RideOptions",
   "route": "elbow",
   "trigger": "tap Change ride",
   "kind": "forward"
  },
  {
   "from": "FindingDriver",
   "to": "HomeMap",
   "route": "elbow",
   "trigger": "tap Cancel",
   "kind": "forward"
  },
  {
   "from": "DriverAssigned",
   "to": "DriverArriving",
   "trigger": "the screen advances on its own",
   "system": "clock",
   "main": true,
   "code": "C2"
  },
  {
   "from": "HomeMap",
   "to": "ProfileTab",
   "trigger": "tap Profile tab"
  },
  {
   "from": "DriverArriving",
   "to": "ChatWithDriver",
   "trigger": "tap Message"
  },
  {
   "from": "ChatWithDriver",
   "to": "DriverArriving",
   "trigger": "tap Back",
   "kind": "back"
  },
  {
   "from": "DriverArriving",
   "to": "InTrip",
   "trigger": "the driver starts the trip",
   "system": "bolt",
   "main": true,
   "code": "C3"
  },
  {
   "from": "DriverArriving",
   "to": "HomeMap",
   "route": "elbow",
   "trigger": "tap Cancel ride",
   "kind": "forward"
  },
  {
   "from": "InTrip",
   "to": "ShareTripStatus",
   "trigger": "tap Share"
  },
  {
   "from": "ShareTripStatus",
   "to": "InTrip",
   "trigger": "tap Done",
   "kind": "back"
  },
  {
   "from": "InTrip",
   "to": "SosEmergency",
   "trigger": "tap SOS"
  },
  {
   "from": "SosEmergency",
   "to": "InTrip",
   "route": "elbow",
   "trigger": "tap I am safe",
   "kind": "forward"
  },
  {
   "from": "SosEmergency",
   "to": "SupportHelp",
   "trigger": "tap Call support"
  },
  {
   "from": "InTrip",
   "to": "TripComplete",
   "trigger": "the car reaches the drop-off",
   "system": "bolt",
   "main": true,
   "code": "C4"
  },
  {
   "from": "TripComplete",
   "to": "RateDriver",
   "trigger": "tap Rate",
   "main": true
  },
  {
   "from": "RateDriver",
   "to": "TipDriver",
   "trigger": "tap Submit",
   "main": true
  },
  {
   "from": "TipDriver",
   "to": "PaymentApprovedCheck",
   "trigger": "tap Pay",
   "main": true
  },
  {
   "from": "PaymentApprovedCheck",
   "to": "ReceiptView",
   "guard": "card approved",
   "main": true
  },
  {
   "from": "PaymentApprovedCheck",
   "to": "PaymentFailed",
   "guard": "card declined",
   "kind": "failure"
  },
  {
   "from": "PaymentFailed",
