   "route": "elbow",
   "trigger": "tap Retry",
   "kind": "retry"
  },
  {
   "from": "PaymentMethods",
   "to": "AddCard",
   "trigger": "tap Add card"
  },
  {
   "from": "AddCard",
   "to": "ThreeDSecure",
   "trigger": "tap Save"
  },
  {
   "from": "ThreeDSecure",
