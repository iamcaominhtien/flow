{
  "type": "er",
  "title": "ER: food delivery",
  "desc": "Customers place orders at restaurants; couriers deliver them. A solid line is a foreign key; a dashed one is only a logical link.",
  "tables": [
    {"id": "customers", "name": "customers", "icon": "user", "tone": "blue", "columns": [
      {"name": "id", "type": "bigint", "flags": ["pk"]},
      {"name": "email", "type": "text", "flags": ["uq"]},
      {"name": "name", "type": "text"}]},
    {"id": "restaurants", "name": "restaurants", "icon": "store", "tone": "green", "columns": [
      {"name": "id", "type": "bigint", "flags": ["pk"]},
      {"name": "name", "type": "text"},
      {"name": "city", "type": "text", "flags": ["null"]}]},
    {"id": "orders", "name": "orders", "icon": "box", "tone": "violet", "columns": [
      {"name": "id", "type": "bigint", "flags": ["pk"]},
      {"name": "customer_id", "type": "bigint", "flags": ["fk"]},
      {"name": "restaurant_id", "type": "bigint", "flags": ["fk"]},
      {"name": "courier_id", "type": "bigint", "flags": ["fk", "null"]},
      {"name": "status", "type": "text"}]},
    {"id": "couriers", "name": "couriers", "icon": "bike", "tone": "teal", "columns": [
