      {"name": "name", "type": "text"}]},
    {"id": "payments", "name": "payments", "icon": "card", "tone": "amber", "columns": [
      {"name": "id", "type": "bigint", "flags": ["pk"]},
      {"name": "order_id", "type": "bigint", "flags": ["fk", "uq"]},
      {"name": "amount", "type": "numeric"}]}
  ],
  "relations": [
    {"from": "customers", "to": "orders", "from_column": "id", "to_column": "customer_id", "label": "places", "main": true},
    {"from": "restaurants", "to": "orders", "from_column": "id", "to_column": "restaurant_id", "label": "receives"},
    {"from": "couriers", "to": "orders", "to_end": "zero_many", "from_end": "zero_one", "label": "delivers"},
    {"from": "orders", "to": "payments", "to_end": "one", "from_end": "one", "label": "is paid by", "style": "logical"}
  ]
