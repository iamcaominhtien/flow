    {"id": "stock", "kind": "decision", "text": "In stock?", "number": "3"},
    {"id": "authorize", "kind": "process", "text": "Authorize card", "number": "4"},
    {"id": "approved", "kind": "decision", "text": "Approved?", "number": "5"},
    {"id": "receipt", "kind": "document", "text": "Receipt", "number": "6"},
    {"id": "done", "kind": "terminator", "text": "Order confirmed"},
    {"id": "out", "kind": "process", "text": "Show out-of-stock", "number": "3a"},
    {"id": "retry", "kind": "decision", "text": "Retry < 3?", "number": "5a"},
    {"id": "cancel", "kind": "process", "text": "Cancel order"},
    {"id": "failed", "kind": "fail", "text": "Payment failed"}
  ],
  "edges": [
    {"from": "start", "to": "load", "role": "main"},
    {"from": "load", "to": "address", "role": "main"},
