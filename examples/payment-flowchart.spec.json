    {"from": "authorize", "to": "approved", "role": "main"},
    {"from": "approved", "to": "receipt", "role": "main", "label": "Yes"},
    {"from": "receipt", "to": "done", "role": "main"},
    {"from": "stock", "to": "out", "role": "no", "label": "No"},
    {"from": "out", "to": "load", "role": "back", "label": "Edit cart"},
    {"from": "approved", "to": "retry", "role": "no", "label": "No"},
    {"from": "retry", "to": "authorize", "role": "back", "label": "Yes"},
    {"from": "retry", "to": "cancel", "role": "no", "label": "No"},
