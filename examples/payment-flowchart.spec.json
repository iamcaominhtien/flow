{
  "type": "flowchart",
  "title": "Online payment",
  "desc": "All parts together: numbered steps, a subprocess, two decisions, a retry loop, an error branch, a document and the one animated main path from start to confirmation.",
  "direction": "right",
  "nodes": [
    {"id": "start", "kind": "terminator", "text": "Cart ready"},
