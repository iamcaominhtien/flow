{
  "type": "state",
  "title": "State machine: a ride trip",
  "desc": "The states of a ride trip from request to payment, with cancellation, in-trip safety and dispute paths.",
  "states": [
    {"id": "begin", "kind": "start"},
    {"id": "requested", "label": "Requested", "tone": "blue", "entry": "start search timer"},
    {"id": "nodriver", "label": "NoDriver", "tone": "amber"},
    {"id": "assigned", "label": "Assigned", "states": [
      {"id": "enroute", "label": "EnRoute", "tone": "green"},
      {"id": "arrived", "label": "Arrived", "tone": "green"},
      {"id": "waiting", "label": "Waiting", "tone": "amber", "do": "charge waiting fee per minute"}]},
    {"id": "inprogress", "label": "InProgress", "states": [
      {"id": "movement", "label": "Movement", "states": [
        {"id": "driving", "label": "Driving", "tone": "teal"},
        {"id": "paused", "label": "Paused", "tone": "teal"},
        {"id": "rerouting", "label": "Rerouting", "tone": "teal"}]},
      {"id": "safety", "label": "Safety", "states": [
        {"id": "normal", "label": "Normal", "tone": "violet"},
        {"id": "sosactive", "label": "SosActive", "tone": "violet"},
        {"id": "monitored", "label": "Monitored", "tone": "violet"}]}]},
    {"id": "suspended", "label": "Suspended", "tone": "gray"},
    {"id": "completing", "label": "Completing", "tone": "blue", "do": "calculate fare"},
    {"id": "charging", "label": "Charging", "tone": "blue"},
    {"id": "awaitingcash", "label": "AwaitingCash", "tone": "blue"},
    {"id": "paymentdue", "label": "PaymentDue", "tone": "amber"},
    {"id": "paid", "label": "Paid", "tone": "green"},
    {"id": "disputed", "label": "Disputed", "tone": "amber"},
    {"id": "refunded", "label": "Refunded", "tone": "gray"},
    {"id": "cancelled", "label": "Cancelled", "kind": "fail"},
    {"id": "cancelledfee", "label": "CancelledWithFee", "kind": "fail"},
    {"id": "aborted", "label": "Aborted", "kind": "fail"},
    {"id": "writtenoff", "label": "WrittenOff", "kind": "end"},
    {"id": "closed", "label": "Closed", "kind": "end"}
  ],
  "transitions": [
    {"from": "begin", "to": "requested", "main": true},
    {"from": "requested", "to": "enroute", "event": "driverAccepted", "main": true},
    {"from": "requested", "to": "nodriver", "event": "timeout", "guard": "after 60 s"},
    {"from": "requested", "to": "cancelled", "event": "riderCancelled"},
    {"from": "nodriver", "to": "requested", "event": "retry", "guard": "attempts < 3"},
    {"from": "nodriver", "to": "cancelled", "event": "retry", "guard": "attempts >= 3"},
    {"from": "nodriver", "to": "cancelled", "event": "giveUp"},
    {"from": "enroute", "to": "enroute", "event": "gpsUpdate", "action": "recalculate ETA"},
    {"from": "enroute", "to": "arrived", "event": "reachedPickup", "main": true},
    {"from": "arrived", "to": "waiting", "event": "after 2 min"},
    {"from": "arrived", "to": "driving", "event": "riderOnBoard", "main": true},
    {"from": "waiting", "to": "driving", "event": "riderOnBoard"},
    {"from": "enroute", "to": "requested", "event": "driverCancelled", "action": "re-match"},
    {"from": "arrived", "to": "requested", "event": "driverCancelled", "action": "re-match"},
    {"from": "waiting", "to": "requested", "event": "driverCancelled", "action": "re-match"},
    {"from": "enroute", "to": "cancelled", "event": "riderCancelled", "guard": "before arrival", "action": "no fee"},
    {"from": "arrived", "to": "cancelledfee", "event": "riderCancelled", "guard": "after arrival"},
    {"from": "waiting", "to": "cancelledfee", "event": "riderCancelled", "guard": "after arrival"},
    {"from": "arrived", "to": "cancelledfee", "event": "noShow", "guard": "waited 5 min"},
    {"from": "waiting", "to": "cancelledfee", "event": "noShow", "guard": "waited 5 min"},
    {"from": "driving", "to": "paused", "event": "stopRequested"},
    {"from": "paused", "to": "driving", "event": "resume"},
    {"from": "driving", "to": "rerouting", "event": "destinationChanged"},
    {"from": "rerouting", "to": "driving", "event": "routeReady"},
    {"from": "normal", "to": "sosactive", "event": "sosPressed"},
    {"from": "sosactive", "to": "monitored", "event": "supportJoined"},
    {"from": "monitored", "to": "normal", "event": "resolved"},
    {"from": "sosactive", "to": "aborted", "event": "emergencyStop"},
    {"from": "driving", "to": "completing", "event": "arrivedAtDestination", "main": true},
    {"from": "driving", "to": "suspended", "event": "connection lost"},
    {"from": "suspended", "to": "driving", "event": "reconnected", "action": "return to previous substate (history)"},
    {"from": "completing", "to": "charging", "guard": "card on file", "main": true},
    {"from": "completing", "to": "awaitingcash", "guard": "cash"},
    {"from": "charging", "to": "paid", "event": "approved", "main": true},
    {"from": "charging", "to": "charging", "event": "declined", "guard": "retries < 2"},
    {"from": "charging", "to": "paymentdue", "event": "declined", "guard": "retries >= 2"},
    {"from": "awaitingcash", "to": "paid", "event": "driverConfirmsCash"},
    {"from": "paymentdue", "to": "paid", "event": "paidLater"},
    {"from": "paymentdue", "to": "writtenoff", "event": "after 7 days"},
    {"from": "paid", "to": "closed", "event": "rated", "main": true},
    {"from": "paid", "to": "closed", "event": "after 24 h"},
    {"from": "paid", "to": "disputed", "event": "disputeOpened"},
    {"from": "disputed", "to": "refunded", "event": "resolvedForRider"},
    {"from": "refunded", "to": "closed"},
    {"from": "disputed", "to": "closed", "event": "resolvedForDriver"}
  ]
}
